FROM docker.io/library/node:24.20.0-alpine3.24@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build

WORKDIR /src

COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
RUN npm ci --no-audit --no-fund

COPY core ./core
COPY documents ./documents
COPY measurement ./measurement
COPY server ./server
RUN npm run build

FROM docker.io/library/node:24.20.0-alpine3.24@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build --chown=node:node /src/dist ./dist

USER node
EXPOSE 3100

CMD ["node", "dist/server/main.js"]
