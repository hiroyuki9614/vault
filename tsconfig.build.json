{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "core/**/*.ts",
    "documents/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "tests/**"
  ]
}
